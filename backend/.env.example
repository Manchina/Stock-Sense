# ==============================================================================
# StockSense Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
# Example Neon connection string (pooled connection recommended):
# postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/stocksense?sslmode=require

# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace-with-a-very-secure-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-secure-random-secret-for-refresh-tokens

# CORS Allowed Origins (Comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173
